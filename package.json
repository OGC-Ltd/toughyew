{
  "name": "toughyew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,styles,client -c cyan,magenta,yellow \"tsx watch --clear-screen=false src/server.ts\" \"sass --watch --no-source-map --no-charset src/styles/main.scss:public/css/main.css\" \"tsc -p tsconfig.client.json --watch --preserveWatchOutput\"",
    "build": "npm run build:styles && npm run build:client && npm run build:server",
    "build:server": "tsc -p tsconfig.json",
    "build:styles": "sass --no-source-map --no-charset --style=expanded src/styles/main.scss:public/css/main.css",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build:client": "tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/pug": "^2.0.10",
    "concurrently": "^10.0.7",
    "sass": "^1.108.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
