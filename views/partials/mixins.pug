mixin picture(p, opts = {})
  img(src=`/img/photos/${p.base}-1920.jpg` srcset=p.w > 960 ? `/img/photos/${p.base}-960.jpg 960w, /img/photos/${p.base}-1920.jpg ${p.w}w` : `/img/photos/${p.base}-960.jpg ${p.w}w` sizes=opts.sizes || '100vw' width=p.w height=p.h alt=opts.decorative ? '' : p.alt style=p.pos ? `object-position: ${p.pos}` : undefined loading=opts.eager ? undefined : 'lazy' fetchpriority=opts.eager ? 'high' : undefined decoding="async")

mixin icon(name)
  //- Lucide icons, 24px grid, stroke inherits currentColor
  svg.icon(viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
    case name
      when 'arrow-right'
        path(d="M5 12h14")
        path(d="m12 5 7 7-7 7")
      when 'arrow-left'
        path(d="m12 19-7-7 7-7")
        path(d="M19 12H5")
      when 'arrow-up'
        path(d="m5 12 7-7 7 7")
        path(d="M12 19V5")
      when 'chevron-down'
        path(d="m6 9 6 6 6-6")
      when 'plus'
        path(d="M5 12h14")
        path(d="M12 5v14")
      when 'pause'
        rect(x="14" y="4" width="4" height="16" rx="1")
        rect(x="6" y="4" width="4" height="16" rx="1")
      when 'play'
        polygon(points="6 3 20 12 6 21 6 3")
      when 'x'
        path(d="M18 6 6 18")
        path(d="m6 6 12 12")
      when 'map-pin-off'
        path(d="M12.75 7.09a3 3 0 0 1 2.16 2.16")
        path(d="M17.072 17.072c-1.634 2.17-3.527 3.912-4.471 4.727a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 1.432-4.568")
        path(d="m2 2 20 20")
        path(d="M8.475 2.818A8 8 0 0 1 20 10c0 1.183-.31 2.377-.8 3.533")
        path(d="M9.13 9.13a3 3 0 0 0 3.74 3.74")
      when 'printer'
        path(d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2")
        path(d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6")
        rect(x="6" y="14" width="12" height="8" rx="1")
      when 'menu'
        line(x1="4" x2="20" y1="6" y2="6")
        line(x1="4" x2="20" y1="12" y2="12")
        line(x1="4" x2="20" y1="18" y2="18")

//- Page numbers under a staff list (src/paging.ts). Shown only when there is more than one page.
mixin pager(p, label)
  if p && p.pages > 1
    nav.pager(aria-label=label || 'Pages')
      if p.prev
        a.pager__step(href=p.prev rel="prev") Previous
      else
        span.pager__step.pager__step--off(aria-hidden="true") Previous
      ol.pager__pages
        each l in p.links
          if l.gap
            li.pager__gap(aria-hidden="true") …
          else
            li
              a.pager__num(href=l.href aria-current=l.current ? 'page' : undefined aria-label=`Page ${l.n}`)= l.n
      if p.next
        a.pager__step(href=p.next rel="next") Next
      else
        span.pager__step.pager__step--off(aria-hidden="true") Next
