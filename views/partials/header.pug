- const nav = [{ href: '/', label: 'Home' }, { href: '/about', label: 'About' }, { href: '/contact', label: 'Contact' }]
header.site-header
  .container.site-header__inner
    a.brand(href="/")
      span.brand__mark(aria-hidden="true") T
      span.brand__name= appName
    nav.site-nav(aria-label="Main")
      ul
        each item in nav
          li
            a(href=item.href aria-current=(path === item.href ? 'page' : undefined))= item.label
