- const work = [{ href: '/new-builds', label: 'New builds' }, { href: '/renovations', label: 'Renovations and extensions' }, { href: '/joinery', label: 'Bespoke joinery' }]
- const nav = [{ href: '/#process', label: 'How we work' }, { href: '/#inspiration', label: 'Inspiration' }, { href: '/#questions', label: 'Questions' }]

.masthead
  .utility
    .container.utility__inner
      p.utility__tagline Building. Lasting. Strong.
      a.utility__quote(href="/supplier-quote" aria-current=path === '/supplier-quote' ? 'page' : undefined)
        span Send us a quotation
        +icon('arrow-right')

  header.site-header(data-header)
    .container.site-header__inner
      a.lockup(href="/" aria-label="Tough Yew Co., home")
        img.lockup__mark(src="/img/brand/mark.png" alt="" width="505" height="500")
        span.lockup__name Tough Yew Co.

      nav.primary(aria-label="Main")
        ul.primary__list
          li.primary__item.has-menu(data-menu)
            button.primary__link(type="button" aria-expanded="false" aria-controls="menu-work")
              | What we do
              +icon('chevron-down')
            ul.primary__menu#menu-work
              each item in work
                li: a(href=item.href aria-current=item.href === path ? 'page' : undefined)= item.label
          each item in nav
            li.primary__item: a.primary__link(href=item.href)= item.label
        a.btn.btn--primary.primary__cta(href="/#enquire") Start a project

      details.drawer(data-drawer)
        summary.drawer__toggle
          +icon('menu')
          span Menu
        .drawer__panel
          p.drawer__label What we do
          ul
            each item in work
              li: a(href=item.href aria-current=item.href === path ? 'page' : undefined)= item.label
          ul
            each item in nav
              li: a(href=item.href aria-current=item.href === path ? 'page' : undefined)= item.label
          a.btn.btn--primary(href="/#enquire") Start a project
