footer.site-footer
  .container
    .site-footer__grid
      .site-footer__brand
        a.lockup.lockup--light(href="/" aria-label="Tough Yew Co., home")
          img.lockup__mark(src="/img/brand/mark.png" alt="" width="505" height="500")
          span.lockup__name Tough Yew Co.
        p.site-footer__tagline Building. Lasting. Strong.
      nav.site-footer__col(aria-label="Our work")
        h2 Our work
        ul
          li: a(href="/new-builds" aria-current=path === '/new-builds' ? 'page' : undefined) New builds
          li: a(href="/renovations" aria-current=path === '/renovations' ? 'page' : undefined) Renovations and extensions
          li: a(href="/joinery" aria-current=path === '/joinery' ? 'page' : undefined) Bespoke joinery
          li: a(href="/#inspiration") Inspiration
      nav.site-footer__col(aria-label="Company")
        h2 Company
        ul
          li: a(href="/#about") Why Tough Yew
          li: a(href="/#process") How we work
          li: a(href="/#questions") Questions
          li: a(href="/#enquire") Enquire
      section.site-footer__col.site-footer__suppliers(aria-labelledby="footer-suppliers")
        h2#footer-suppliers Suppliers
        p Quoting for materials we need? Send your prices, quantities and terms on one form.
        a.btn.btn--on-dark(href="/supplier-quote" aria-current=path === '/supplier-quote' ? 'page' : undefined)
          span Send us a quotation
          +icon('arrow-right')
    .site-footer__legal
      a.site-footer__privacy(href="/privacy" aria-current=path === '/privacy' ? 'page' : undefined)
        span Privacy policy
      p.site-footer__copy © #{year} Tough Yew Co.
      a.to-top(href="#main" data-to-top)
        +icon('arrow-up')
        span Back to top
