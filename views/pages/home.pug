extends ../layouts/base

block content
  section.hero
    p.eyebrow Server-rendered starter
    h1.hero__title Build fast, render on the server.
    p.hero__lead #{appName} is an Express app written in TypeScript, with Pug templates and SCSS styles.
    .hero__actions
      a.btn.btn--primary(href="/contact") Get in touch
      a.btn.btn--ghost(href="/about") Learn more

  section.grid(aria-label="Stack")
    each f in features
      +card(f.title)
        p= f.body
