extends ../layouts/base

mixin field(name, label, opts = {})
  - const err = errors[name]
  - const described = err ? `e-${name}` : undefined
  .field(class={ 'field--wide': !!opts.wide, 'field--error': !!err })
    label(for=`f-${name}`)
      = label
      if opts.optional
        span.field__opt  (optional)
    if opts.multiline
      textarea(id=`f-${name}` name=name rows="5" required=!opts.optional aria-invalid=err ? 'true' : undefined aria-describedby=described autofocus=(firstError === name))= values[name]
    else if opts.options
      select(id=`f-${name}` name=name required=!opts.optional aria-invalid=err ? 'true' : undefined aria-describedby=described autofocus=(firstError === name))
        option(value="" selected=!values[name])= opts.placeholder
        each o in opts.options
          option(value=o.value selected=(values[name] === o.value))= o.label
    else
      input(id=`f-${name}` name=name type=opts.type || 'text' value=values[name] autocomplete=opts.autocomplete inputmode=opts.inputmode required=!opts.optional aria-invalid=err ? 'true' : undefined aria-describedby=described autofocus=(firstError === name))
    p.field__error(id=`e-${name}`)= err || ''

block content
  //- 1. Hero: full-bleed slideshow
  section.hero(aria-roledescription="carousel" aria-label="Our kind of work" data-slideshow)
    .hero__slides
      each s, i in slides
        figure.hero__slide(class=i === 0 ? 'is-active' : undefined aria-roledescription="slide" aria-label=`${i + 1} of ${slides.length}` aria-hidden=i === 0 ? undefined : 'true')
          +picture(s.photo, { eager: i === 0 })
          figcaption.hero__caption= s.caption
    .hero__scrim
    .container.hero__content
      h1 Strong roots. Exceptional spaces.
      p.lead New builds, extensions and bespoke joinery, made to stand for generations.
      .hero__actions
        a.btn.btn--primary.btn--lg(href="#enquire")
          span Tell us about your project
          +icon('arrow-right')
        a.btn.btn--ghost-light.btn--lg(href="#services") Explore what we do
    .container.hero__controls(data-controls hidden)
      .hero__dots(role="group" aria-label="Choose a slide")
        each s, i in slides
          button.hero__dot(type="button" aria-label=`Show slide ${i + 1}: ${s.caption}` aria-current=i === 0 ? 'true' : undefined data-goto=i)
            span.hero__dot-fill
      button.hero__pause(type="button" data-pause aria-label="Pause the slideshow")
        span.hero__pause-icon.hero__pause-icon--pause
          +icon('pause')
        span.hero__pause-icon.hero__pause-icon--play
          +icon('play')

  //- 2. Welcome
  section#about.welcome
    .container.welcome__inner(data-reveal)
      h2 Built to stand for generations.
      p.lead Like the yew, strength comes from the roots. We build on sound foundations, with honest materials and care in every detail, so the place you live works beautifully and lasts.
      p.welcome__cta
        a.text-link(href="#enquire")
          span Let’s build something that lasts
          +icon('arrow-right')

  //- 3. Services: card grid
  section#services.services
    .container
      .section-head(data-reveal)
        h2 Your vision. Our craft.
        a.text-link(href="#enquire")
          span Start a project
          +icon('arrow-right')
      ul.cards
        each s, i in services
          li.card(data-reveal style=`--i: ${i}`)
            a.card__link(href=`/?type=${s.slug}#enquire`)
              .card__media
                +picture(s.photo, { sizes: '(max-width: 60rem) 100vw, 33vw' })
              .card__body
                h3= s.title
                p= s.body
                span.card__more
                  | Enquire about #{s.title.toLowerCase()}
                  +icon('arrow-right')

  //- 4. Feature split
  section.feature
    .container.feature__inner
      .feature__media(data-reveal="wipe")
        +picture(photos.carpenter, { sizes: '(max-width: 60rem) 100vw, 50vw' })
      .feature__text(data-reveal)
        h2 Good building. No shortcuts.
        p.lead We listen carefully, plan thoroughly and treat your home as a home.
        dl.feature__facts
          div
            dt Honest materials
            dd Chosen to last, never to cut a corner.
          div
            dt Thoughtful details
            dd The finish gets the same care as the frame.
        .feature__actions
          a.btn.btn--primary(href="#process") How we work
          a.btn.btn--outline(href="#inspiration") See inspiration

  //- 5. Process: step cards
  section#process.process
    .container
      .section-head(data-reveal)
        h2 Solid from the start.
        p.lead Four steps, from the first conversation to the handover.
      ol.steps(data-steps)
        each st, i in steps
          li.step(data-reveal style=`--i: ${i}`)
            span.step__tag Step #{i + 1}
            h3= st.title
            p= st.body

  //- 6. Gallery rail
  section#inspiration.gallery
    .container
      .section-head(data-reveal)
        h2 Spaces to inspire.
        .gallery__nav(data-rail-nav hidden)
          button.round-btn(type="button" data-rail-prev aria-label="Previous photographs")
            +icon('arrow-left')
          button.round-btn(type="button" data-rail-next aria-label="Next photographs")
            +icon('arrow-right')
    ul.rail(data-rail tabindex="0" aria-label="Inspiration photographs, scroll sideways")
      each g in gallery
        li.rail__item
          figure
            .rail__media
              +picture(g.photo, { sizes: '(max-width: 40rem) 85vw, 34vw' })
            figcaption
              strong= g.title
              span= g.line

  //- 7. Questions
  section#questions.questions
    .container.questions__inner
      .questions__head(data-reveal)
        h2 Let’s clear things up.
        p.lead Before you get in touch.
      .questions__list(data-reveal)
        each f in faqs
          details.faq(data-faq)
            summary
              span= f.q
              span.faq__icon
                +icon('plus')
            .faq__body
              p= f.a

  //- 8. Enquiry: boxed form
  section#enquire.enquire
    .container.enquire__inner
      .enquire__intro(data-reveal)
        h2 Let’s build something that lasts.
        p.lead Big idea or early days, we’d like to hear what you have in mind.
      form.enquiry(method="post" action="/enquire" novalidate data-reveal)
        h3 Tell us about your project
        if sent
          p.notice(role="status") Thank you. Your enquiry has reached us and we will reply by email.
        else if Object.keys(errors).length
          p.notice.notice--error(role="alert") Some details need another look before we can send this.
        .enquiry__fields
          +field('name', 'Your name', { autocomplete: 'name' })
          +field('email', 'Email address', { type: 'email', autocomplete: 'email', inputmode: 'email' })
          +field('phone', 'Phone number', { type: 'tel', autocomplete: 'tel', inputmode: 'tel', optional: true })
          +field('location', 'Project location', { autocomplete: 'address-level2' })
          +field('type', 'Project type', { options: projectTypes, placeholder: 'Choose a project type' })
          +field('start', 'Ideal start', { options: timeframes, placeholder: 'Choose a timeframe', optional: true })
          +field('budget', 'Approximate budget', { optional: true, wide: true })
          +field('message', 'Tell us more', { multiline: true, wide: true })
        .check(class={ 'field--error': !!errors.consent })
          input#f-consent(type="checkbox" name="consent" value="yes" checked=(values.consent === 'yes') aria-invalid=errors.consent ? 'true' : undefined aria-describedby=errors.consent ? 'e-consent' : undefined autofocus=(firstError === 'consent'))
          label(for="f-consent") I agree to be contacted about this enquiry.
          p.field__error#e-consent= errors.consent || ''
        button.btn.btn--primary.btn--lg.enquiry__submit(type="submit" data-submit)
          span Send project enquiry
          +icon('arrow-right')
